# ------------------------------------------------------------
# GitHub 연동 (필수)
# ------------------------------------------------------------

# GitHub Personal Access Token
# 발급: Settings -> Developer settings -> Personal access tokens (classic)
# 필요 권한: repo (private 포함), admin:repo_hook (웹훅 복구 사용 시)
GITHUB_TOKEN=

# 본인 GitHub 사용자명 (자기 코멘트 무시 옵션 등에 사용)
GITHUB_LOGIN=

# GitHub Webhook 등록 시 입력한 Secret 문자열과 동일하게
# (Repo Settings -> Webhooks -> 해당 webhook -> Secret)
GITHUB_WEBHOOK_SECRET=

# 분석 대상 레포 풀네임, (예: owner/repo-a,owner/repo-b)
# 비어 있으면 웹훅 복구( Redelivery ) 기능이 비활성화됨
GITHUB_REPOS=

# ------------------------------------------------------------
# Groq LLM (필수)
# ------------------------------------------------------------

# Groq API Key
# 발급: https://console.groq.com/keys
GROQ_API_KEY=

# ------------------------------------------------------------
# Slack 통지 (필수)
# ------------------------------------------------------------

# Slack Incoming Webhook URL
# 발급 가이드: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ------------------------------------------------------------
# ngrok (docker-compose로 띄울 때 필수)
# ------------------------------------------------------------

# ngrok 인증 토큰
# 발급: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ngrok static domain (무료 플랜에서도 1개 제공)
# 발급: https://dashboard.ngrok.com/domains
# 예: tasty-cat-1234.ngrok-free.app
NGROK_DOMAIN=

# ------------------------------------------------------------
# 선택값 (필요할 때만 주석 해제)
# ------------------------------------------------------------

# 서버 포트 (기본 8080)
# SERVER_PORT=8080

# Slack 통지를 완전히 끄려면 false
# SLACK_ENABLED=true

# 본인이 단 코멘트도 분석할지 (false면 자기 코멘트 무시)
# PR_ANALYZER_INCLUDE_OWN_COMMENTS=true

# 로그 레벨 (운영은 INFO 권장)
# LOGGING_LEVEL_COM_PR_AUTOMATION=INFO

# 웹훅 복구 스케줄러 (기본 30분 간격)
# GITHUB_WEBHOOK_RECOVERY_SCHEDULER_ENABLED=true
# GITHUB_WEBHOOK_RECOVERY_SCHEDULER_INTERVAL_MS=1800000

# Groq 모델/토큰 한도 조정
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MAX_TOKENS=2048
# GROQ_TEMPERATURE=0.3
