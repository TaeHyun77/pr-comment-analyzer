# GitHub 연동 (필수) ----------

# GitHub Personal Access Token
# 발급: Settings -> Developer settings -> Personal access tokens (classic)
# 필요 권한: repo (private 포함), admin:repo_hook (웹훅 복구 사용 시)
GITHUB_TOKEN=

# 본인 GitHub 사용자명 (자기 코멘트 무시 옵션 등에 사용)
GITHUB_LOGIN=

# GitHub Webhook 등록 시 입력한 Secret 문자열과 동일하게
# (Repo Settings -> Webhooks -> 해당 webhook -> Secret)
GITHUB_WEBHOOK_SECRET=

# Groq LLM (필수) ----------

# Groq API Key
# 발급: https://console.groq.com/keys
GROQ_API_KEY=

# Slack 통지 (필수) ----------

# Slack Incoming Webhook URL
# 발급 가이드: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ngrok (docker-compose로 띄울 때 필수) ----------

# ngrok 인증 토큰
# 발급: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ngrok static domain (무료 플랜에서도 1개 제공)
# 발급: https://dashboard.ngrok.com/domains
# 예: tasty-cat-1234.ngrok-free.app
NGROK_DOMAIN=

# 웹훅 복구 (선택, 사용 시 GITHUB_REPOS 필수), 실시간 웹훅 수신/분석과는 별개. 누락된 deliveries 를 사후 복구하는 기능 ----------

# 복구 대상 레포 풀네임 (예: owner/repo-a,owner/repo-b)
# 비어 있으면 웹훅 복구만 비활성화됨 (실시간 분석에는 영향 없음)
GITHUB_REPOS=

# 웹훅 복구 전체 토글 (부팅 시 1회 복구 + 주기 스케줄러 모두). 기본 true
# GITHUB_WEBHOOK_RECOVERY_ENABLED=false

# 부팅 시 GitHub Webhook Deliveries 를 몇 시간치 훑을지. 기본 24
# GITHUB_WEBHOOK_RECOVERY_LOOKBACK_HOURS=24

# 주기적 복구 스케줄러 토글. 기본 true
# GITHUB_WEBHOOK_RECOVERY_SCHEDULER_ENABLED=false

# 스케줄러 실행 간격(ms). 기본 1800000 (30분)
# GITHUB_WEBHOOK_RECOVERY_SCHEDULER_INTERVAL_MS=1800000

# 스케줄러 1회 실행 시 lookback 시간. 기본 1
# GITHUB_WEBHOOK_RECOVERY_SCHEDULER_LOOKBACK_HOURS=1

# 선택값 (필요할 때만 주석 해제) ----------

# 서버 포트 (기본 8080)
# SERVER_PORT=8080

# Slack 통지를 끄려면 false (기본 true)
# SLACK_ENABLED=false

# 본인이 단 코멘트는 분석에서 제외하려면 false (기본 true)
# PR_ANALYZER_INCLUDE_OWN_COMMENTS=false

# 로그 레벨 (기본 DEBUG, 운영은 INFO 권장)
# LOGGING_LEVEL_COM_PR_AUTOMATION=INFO

# Groq 모델/토큰 한도 조정
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MAX_TOKENS=2048
# GROQ_TEMPERATURE=0.3

# PR 분석 동작 튜닝
# 에이전트 루프 예산. 0 이하면 분석 실패 (기본 8)
# PR_ANALYZER_MAX_TOOL_ITERATIONS=8
# 분석 대상 파일 수 상한 (기본 6)
# PR_ANALYZER_MAX_FILES=6
# 파일당 최대 문자수 (기본 25000)
# PR_ANALYZER_MAX_FILE_CHARS=25000
